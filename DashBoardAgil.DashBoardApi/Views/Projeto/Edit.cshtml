@using DashBoardAgil.DashBoardApi.Common
@model DashBoardAgil.Domain.Models.Projeto


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Projeto</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)

        @Html.Hidden("tipo", (string)ViewBag.tipo)

        <div class="form-group">
            @Html.LabelFor(model => model.Id, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Id, new { htmlAttributes = new { @class = "form-control", disabled = true } })
                @Html.ValidationMessageFor(model => model.Identifier, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Identifier, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Identifier, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Identifier, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Ativo, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.Ativo)
                    @Html.ValidationMessageFor(model => model.Ativo, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="row">
            <table id="slaTable" class="table table-striped table-bordered">
                <thead>
                <th>#</th>
                <th>Descricao</th>
                <th>Tempo</th>
                <th>Tipo Contagem</th>
                <th>Util</th>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Slas.Count; i++)
                {
                        <tr data-Sla_idSla="@Model.Slas[i].Sla.IdSla">
                            <td>@String.Format((i + 1).ToString())</td>
                            <td>@String.Format(Model.Slas[i].Sla.Identificador)</td>
                            @Html.HiddenFor(model => model.Slas[i].IdSla)
                            @Html.HiddenFor(model => model.Slas[i].Sla.Identificador)
                            @Html.HiddenFor(model => model.Slas[i].Sla.StatusDe)
                            @Html.HiddenFor(model => model.Slas[i].Sla.StatusPara)
                            @Html.HiddenFor(model => model.Slas[i].Sla.IdSla)
                            <td>@String.Format(Model.Slas[i].Tempo.ToString())</td>
                            @Html.HiddenFor(model => model.Slas[i].Tempo)
                            <td>@String.Format(Model.Slas[i].TipoContagemTempo.DisplayName())</td>
                            @Html.HiddenFor(model => model.Slas[i].TipoContagemTempo)
                            <td>@String.Format(Model.Slas[i].TempoUltil ? "Sim" : "Não")</td>
                            @Html.HiddenFor(model => model.Slas[i].TempoUltil)
                        </tr>
                    }
                </tbody>
            </table>
        </div>


        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                @Html.ActionLink("Voltar", String.Format("Projetos{0}s", (string)ViewBag.tipo), "Configuracao",null, htmlAttributes: new { @class = "btn btn-primary" })
                <input type="submit" value="Salvar" class="btn btn-primary"/>
            </div>
        </div>
    </div>
}

<script>
    renderDatatable("slaTable");
</script>

<div>
    
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

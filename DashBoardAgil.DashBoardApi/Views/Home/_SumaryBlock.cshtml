@using DashBoardAgil.DashBoardApi.Models


@Html.Partial("_Loading", new DivLoading { Id = "_LoadingSumary" })

<div id="_sumary">
</div>
<script type="text/javascript">
    $(document).ready(function () {

        LoadQauntitativo($("#time").val());

        $("#time").change(function () {

            $("#_LoadingSumary").show();
            $("#_sumary").html("");

            LoadQauntitativo(this.value);
        });

        function LoadQauntitativo(time) {

            var dados = new Object();
            dados.time = time == null ? null : time;

            $.ajax({
                dataType: "json",
                url: "@Url.Action("", "api/Sumary")",
                data: dados,
                complete: function () {
                    $("#_LoadingSumary").hide();
                },
                success: function (data) {
                    if (data != null) {
                        data.forEach(function (item) {
                            var Conteudo = '<div class="col-lg-3 col-md-6">                                                           ' +
                                '         <div class="panel panel-' + item.PaneColor + '">                                            ' +
                                '             <div class="panel-heading">                                                             ' +
                                '             <div class="row">                                                                       ' +
                                '                 <div class="col-xs-3">                                                              ' +
                                '                     <i class="' + item.FaIcon + ' fa-5x"></i>                                       ' +
                                '                 </div>                                                                              ' +
                                '                 <div class="col-xs-9 text-right">                                                   ' +
                                '                     <div class="huge">' + item.Quantidade + '</div>                                 ' +
                                '                     <div>' + item.Mensagem + '</div>                                                ' +
                                '                 </div>                                                                              ' +
                                '             </div>                                                                                  ' +
                                '         </div>                                                                                      ' +
                                '         <a href="' + item.UrlRedmine + '" target="_blank">                                                          ' +
                                '             <div class="panel-footer">                                                              ' +
                                '                 <span class="pull-left">View Details</span>                                         ' +
                                '                 <span class="pull-right"><i class="fa fa-arrow-circle-right"></i></span>            ' +
                                '                                                                                                     ' +
                                '                 <div class="clearfix"></div>                                                        ' +
                                '             </div>                                                                                  ' +
                                '         </a>                                                                                        ' +
                                '     </div>                                                                                          ' +
                                ' </div>';
                            $("#_sumary").append(Conteudo);
                        });
                    }
                }
            });

        }
    });
</script>



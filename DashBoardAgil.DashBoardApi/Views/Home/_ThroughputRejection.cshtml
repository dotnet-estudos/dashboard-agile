@using DashBoardAgil.DashBoardApi.Models
@*<script src="../../code/highcharts.js"></script>
    <script src="../../code/modules/exporting.js"></script>*@


@*<script src="~/Scripts/js/highchart7/highcharts.js"></script>*@
@*<script src="~/Scripts/js/highchart7/modules/exporting.js"></script>*@




<div class="panel panel-default">
    <div class="panel-heading">
        <i class="fas fa-chart-area fa-fw"></i> Throughput X Rejeição
    </div>
    @Html.Partial("_Loading", new DivLoading { Id = "_LoadingThpt" })
    <div id="_ThroughputRejectionDiagram" class="chartSizeble" ></div>
</div>

<script type="text/javascript">
    var __divDados = '_ThroughputRejectionDiagram';
        
    $(document).ready(function () {

        LoadRejections($("#time").val());

        $("#time").change(function () {
            $("#_LoadingThpt").show();
            $("#" + __divDados).html("");
            LoadRejections(this.value);
        });

        $("#pesquisar").on("click", function (e) {
            //alert('chamou Rejection');
            $("#_LoadingThpt").show();
            $("#" + __divDados).html("");
            LoadRejections($("#time").val(), false);
        });

        function LoadRejections(time, dashboard = true) {
            
            var data = new Object();
            data.time = time;
            data.dataIni = $("#dataIni").val();
            data.dataFim = $("#dataFim").val();
            data.dashboard = dashboard;
            var descTime = $('#time :selected').text();
            var periodo = $("#dataIni").val().split('-').reverse().join('/') + ' à ' + $("#dataFim").val().split('-').reverse().join('/');

            $.ajax({
                dataType: "json",
                url: "@Url.Action("", "api/Rejections")",
                data: data,
                complete: function () {
                    $("#_LoadingThpt").hide();
                },
                success: function (datas) {
                    if (datas != null) {
                        _time = time;
                        renderRejectionThroughput(__divDados, 'Throughput X Rejeição do time: ' + descTime, 'Source: redmine.example.com | Interval: '+periodo, datas.Categoria, datas.Serie, (datas.Throughput.ThroughputWeek ? datas.Throughput.ThroughputWeek : datas.Throughput.Throughput), datas.Rejeicao.RejectionsRate);
                    }
                }

            });
        }



    });


</script>

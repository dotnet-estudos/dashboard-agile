<div class="panel panel-default">
    <div class="panel-heading">
        <i class="fas fa-chart-area fa-fw"></i> Throughput X Rejeição
    </div>
    @Html.Partial("_Loading", new DivLoading { Id = "_LoadingThpt" })
    <div id="_ThroughputRejectionDiagram" class="chartSizeble" ></div>
</div>

<script type="text/javascript">
    var __divDados = '_ThroughputRejectionDiagram';
    
    $(document).ready(function () {

        LoadRejections($("#time").val());

        $("#time").change(function () {
            $("#_LoadingThpt").show();
            $("#" + __divDados).html("");
            LoadRejections(this.value);
        });

        /*$("#pesquisar").on("click", function (e) {
            alert('chamou Rejection');
            $("#_LoadingThpt").show();
            $("#" + __divDados).html("");
            LoadRejections($("#time").val());
        });*/

        function LoadRejections(time) {
            
            var data = new Object();
            data.time = time;
            data.dataIni = dataIni;//(new Date).getFullYear() + '-01-01';
            data.dataFim = dataFim;//(new Date).getFullYear() + '-' + parseInt((new Date).getMonth() + 1) + '-' + (new Date).getDate();
            data.throughput = true;
            var descTime = $('#time :selected').text();

            $.ajax({
                dataType: "json",
                url: "@Url.Action("", "api/Rejections")",
                data: data,
                complete: function () {
                    $("#_LoadingThpt").hide();
                },
                success: function (datas) {
                    if (datas != null) {
                        _time = time;
                        renderRejectionThroughput(__divDados, 'Throughput X Rejeição do time: ' + descTime, 'Source: redmine.example.com | Year: 2019', datas.Categoria, datas.Serie, (datas.Throughput.ThroughputWeek ? datas.Throughput.ThroughputWeek : datas.Throughput.Throughput), datas.Rejeicao.RejectionsRate);
                    }
                }

            });
        }



    });


</script>

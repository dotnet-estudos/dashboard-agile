@using DashBoardAgil.DashBoardApi.Models
@*<script src="../../code/highcharts.js"></script>
    <script src="../../code/modules/exporting.js"></script>*@


@*<script src="~/Scripts/js/highchart7/highcharts.js"></script>*@
@*<script src="~/Scripts/js/highchart7/modules/exporting.js"></script>*@


<div class="panel panel-default">
    <div class="panel-heading">
        <i class="fas fa-chart-area fa-fw"></i> Diagrama de Fluxo Cumulativo <div class="pull-right">Status: <input type="checkbox" id="__fase" value="" /></div>
    </div>
    @Html.Partial("_Loading", new DivLoading { Id = "_LoadingCFD" })
    <div id="_ComulativeFlowDiagram" class="chartSizeble" ></div>
</div>

<script type="text/javascript">
    var DataResult = new Object();
    var divDados = '_ComulativeFlowDiagram';
    var _time = '';

    $(document).ready(function () {

        LoadCFD($("#time").val());

        $("#time").change(function () {
            $("#_LoadingCFD").show();
            $("#_ComulativeFlowDiagram").html("");
            LoadCFD(this.value);
        });

        $("#pesquisar").on("click", function (e) {
            //alert('chamou Cumulative');
            $("#_LoadingCFD").show();
            $("#_ComulativeFlowDiagram").html("");
            LoadCFD($("#time").val(),false);
        });


        $("#__fase").change(function () {
            var toggle = $(this).prop('checked');
            var periodo = $("#dataIni").val().split('-').reverse().join('/') + ' à ' + $("#dataFim").val().split('-').reverse().join('/');
            var descTime = $('#time :selected').text();
            renderComulativeFlow(divDados, 'CFD do time: ' + descTime, 'Source: redmine.example.com | Interval: '+ periodo, DataResult.Semanas, " Chamado", ' Chamado(s)', toggle ? DataResult.Serie : DataResult.SerieFase);
        });

        function LoadCFD(time, dashboard = true) {

            var data = new Object();
            data.time = time;
            data.dataIni = $("#dataIni").val();
            data.dataFim = $("#dataFim").val();
            data.dashboard = dashboard;
            var periodo = $("#dataIni").val().split('-').reverse().join('/') + ' à ' + $("#dataFim").val().split('-').reverse().join('/');
            var descTime = $('#time :selected').text();

            $.ajax({
                dataType: "json",
                url: "@Url.Action("", "api/ComulativeFlowDiagram")",
                data: data,
                complete: function () {
                    $("#_LoadingCFD").hide();
                },
                success: function (datas) {
                    if (datas != null) {
                        DataResult = datas;
                        _time = time;
                        var toggle = $("#__fase").prop('checked');
                        renderComulativeFlow(divDados, 'CFD do time: ' + descTime, 'Source: redmine.example.com | Interval: '+ periodo, datas.Semanas, " Chamado", ' Chamado(s)', toggle ? datas.Serie : datas.SerieFase);
                    }
                }

            });
        }



    });


</script>

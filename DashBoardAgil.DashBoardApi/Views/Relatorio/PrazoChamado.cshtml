@using DashBoardAgil.CrossCutting
@using DashBoardAgil.CrossCutting
@using DashBoardAgil.Services.Domain
@using DashBoardAgil.Services.Util

@{
    ViewBag.title = "Prazo";


}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                Consulta @ViewBag.title
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-lg-12">
                        <form role="form" action="JavaScript: return false;">
                            <div class="form-group col-lg-12">
                                <label>Time:</label>
                                @*<input class="form-control" >*@
                                @Html.DropDownList("time", (SelectList) ViewBag.SelectTime, null, htmlAttributes: new {@class = "form-control", required = true})
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-6">
                                <label>Status:</label>
                                @*<input class="form-control" >*@
                                @Html.DropDownList("Status", ((SelectList)ViewBag.SelectStatusRedmine), "Selecione", htmlAttributes: new { @class = "form-control", required = true })
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-3">
                                <label>Efetiva:</label>
                                @*<input class="form-control" >*@
                                <div class="form-control">
                                    @Html.CheckBox("Efetiva", htmlAttributes: new {@class = "form-control", @checked = true, required = true})
                                    @*<p class="help-block">Exemplo: -level help text here.</p>*@
                                </div>
                            </div>
                            <div class="form-group col-lg-6">
                                <label>Periodo: Inicio</label>
                                @*<input class="form-control" >*@
                                <input type="date" id="dataIni" name="dataIni" class="form-control" value="@DateTime.Now.Date.AddDays(-30).ToString("yyyy-MM-dd")" required/>
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-6">
                                <label>Fim</label>
                                @*<input class="form-control" >*@
                                <input type="date" id="dataFim" name="dataFim" class="form-control" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" required=""/>
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-12">
                                <button type="button" id="pesquisar" class="btn btn-primary">Pesquisar</button>
                            </div>

</form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@Html.Partial("_resultDefault", new DashBoardAgil.DashBoardApi.Models.ResultDefaultModel(new List<string> { "#", "Data Criação", "Status", "Projeto", "Dentro Prazo","Observação", "Termometro (Dia:Hora:Minuto)" }))

<script>
    $(document).ready(function () {
        $("#resultado").hide();
        // $("#carregando_local").html($("#divCarregando").html());
        $(".loading").hide();


        function valid(data) {
            if (time == "" || data.dataIni == "" || data.dataFim == "" || data.status.val == "") {
                return false;
            }
            return true;
        }

        function limpar() {
            $("#render_Grafico").html("");
            $("#_tableAmostra tbody").html("");
            $("#tab_cal_dados").html("");

        }

        function grafico(result) {

            var donuts = new Array();
            var donut = new Object();

            donut.label = "Fora Prazo";
            donut.value = result.PrazoControl.ChamadosOver.length;
            donuts.push(donut);
            donut = new Object();
            donut.label = "Dentro Prazo";
            donut.value = result.PrazoControl.ChamadosIn.length;
            donuts.push(donut);

            $(".dados").show();

            Morris.Donut({
                element: 'render_Grafico',
                data: donuts,
                resize: true
            });

        }

        
        function renderTable(result) {
            //var table = $("#_tableAmostra tbody");
            var table = $("#_tableAmostra").DataTable();

            table.clear().draw();


            result.PrazoControl.ChamadoSemafaro.forEach(function (chamado, index) {

                var conteudo = new Array();

                conteudo.push("<a target='_blank' href='http://redmine.example.com/issues/" + chamado.Id + "'> #" + chamado.Id + "</a>");
                conteudo.push(chamado.DataCriacao);
                conteudo.push(chamado.StatusRedmine);
                conteudo.push(chamado.Project.Identifier);
                conteudo.push((chamado.Under == true ? "Sim" : "Não"));
                conteudo.push((chamado.Mensagem));
                conteudo.push(chamado.TimeTo); //TimeTo //HourTo

                table.row.add(conteudo);

            });

            table.draw();

        }


        function renderCalendario(result) {

            var notes = new Array();

            result.PrazoControl.ChamadosPorDia.forEach(function (item, index) {

                var object = new Object();

                object.date = item.DataString;
                object.note = item.ChamadosArray;
                notes.push(object);
              
            });


            renderCalendar("#tab_cal_dados", notes, result.filtro.dataIni.substring(0, 10), result.filtro.dataFim.substring(0, 10));

        }

        $("#pesquisar").on("click", function (e) {

            $("#resultado").hide();
            limpar();
            $('#i_tab-grafico').click();

            var data = new Object();

            data.time = $("#time").val();
            data.efetiva = $("#Efetiva").is(":checked") ? true : false;
            data.dataIni = $("#dataIni").val();
            data.dataFim = $("#dataFim").val();
            data.status = $("#Status").val();

            if (valid(data)) {

                $.ajax({
                    url: "@Url.Action("", "api/PrazoChamado/")",
                    data: data,
                    method: "GET",
                    beforeSend: function () {
                        $("#resultado").show();
                        $(".loading").show();
                        $(".dados").hide();
                    },
                    success: function (result) {
                        console.log(result);

                        grafico(result);

                        renderTable(result);

                        renderCalendario(result);

                    },
                    complete: function () {
                        $(".loading").hide();
                    }

                });
            } else {
                dashboard.alertAtencao("Todos Campos são obrigatorios");
            }


        });
    });
</script>
@Scripts.Render("~/bundles/jqueryval")
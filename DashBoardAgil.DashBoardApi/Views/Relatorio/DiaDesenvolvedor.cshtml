@using DashBoardAgil.CrossCutting
@using DashBoardAgil.Domain.Models
@using DashBoardAgil.Services.Util
@model SlaControl
@{
    ViewBag.title = "Dia Desenvolvedor";

    var ListAbas = new Dictionary<string, string>()
    {
        {"Info", "fas fa-info-circle"},
        {"Grafico", "fas fa-chart-bar"},
        {"Dados", "fas fa-list-alt"},
        {"Calendario", "fas fa-chart-bar"},

    };

    var listTable = new List<string> { "Dia", "Time", "Desenvolvedor", "Total(Horas)" };
}

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                Consulta Sla
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-lg-12">
                        <form role="form" action="JavaScript: return false;">
                            <div class="form-group col-lg-12">
                                <label>Time:</label>
                                @*<input class="form-control" >*@
                                @Html.DropDownList("time", (SelectList)ViewBag.SelectTime, "Selecione", htmlAttributes: new { @class = "form-control", required = true })
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-6">
                                <label>Periodo: Inicio</label>
                                @*<input class="form-control" >*@
                                <input type="date" id="dataIni" name="dataIni" class="form-control" value="@DateTime.Now.Date.AddDays(-30).ToString("yyyy-MM-dd")" required />
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-6">
                                <label>Fim</label>
                                @*<input class="form-control" >*@
                                <input type="date" id="dataFim" name="dataFim" class="form-control" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" required="" />
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <button type="button" id="pesquisar" class="btn btn-primary">Pesquisar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_resultDefault", new DashBoardAgil.DashBoardApi.Models.ResultDefaultModel(listTable, ListAbas, false, false, false))


<script>
    

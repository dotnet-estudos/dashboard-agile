      function renderTable(result) {

          $('#dados').html('<table id="dado_table" class="display table table-striped table-bordered" width="100%"><thead></thead><tbody></tbody></table>');

          var dataset = new Array();


            result.DiaDevControl.forEach(function (diaDev, index0) {
                diaDev.LancamentosDiaDesenvolvedor.forEach(function (chamado, index) {

                    var conteudo = new Array();

                    conteudo.push("<a title='' target='_blank' href='http://redmine.example.com/projects/" + diaDev.Time.Identifier + "/time_entries?spent_on=><" + result.filtro.dataIni.substring(0, 10) + "|" + result.filtro.dataFim.substring(0, 10) + "&user_id=" + chamado.User.Id + "'>" + chamado.DiaString + "</a>");
                    conteudo.push(diaDev.Time.Identifier);
                    conteudo.push(chamado.User.FirstName);
                    conteudo.push(chamado.TotalHoraDia);
                    dataset.push(conteudo);
                });
            });

            var dataTable = $('#dado_table').DataTable({
                data: dataset,
                columns: [
                    { title: "Dia", DataProp: "link" },
                    { title: "Time", DataProp: "Projeto" },
                    { title: "Usuário.", DataProp: "Status.Name" },
                    { title: "Total", DataProp: "TipoString" },                   
                ]
            });
            dataTable.destroy();
            renderDatatable("#dado_table");

        }


        function renderCalendario(result) {

            var notes = new Array();
            result.DiaDevControl.forEach(function (diaDev, index0) {
                diaDev.LancamentosDia.forEach(function (item, index) {

                    var object = new Object();

                    object.date = item.Dia.substring(0, 10);
                    object.note = [item.Devs.length];
                    notes.push(object);
                    //[
                    //    { "date": "2018-12-25", "note": ["Natal"] },
                    //    { "date": "2018-12-12", "note": ["Tahun Baru"] }
                    //]
                });
            });

            renderCalendar("#calendario", notes, result.filtro.dataIni.substring(0, 10), result.filtro.dataFim.substring(0, 10));

        }

        $("#pesquisar").on("click", function (e) {

            $("#resultado").hide();
            limpar();
            $('#i_tab-grafico').click();

            var data = new Object();

            data.time = $("#time").val();
            data.dataIni = $("#dataIni").val();
            data.dataFim = $("#dataFim").val();
            data.AceitePO = true;

            if (valid(data)) {

                $.ajax({
                    url: "@Url.Action("", "api/DiaDev")",
                    data: data,
                    method: "GET",
                    beforeSend: function () {
                        $("#resultado").show();
                        $(".loading").show();
                        $(".dados").hide();
                    },
                    success: function (result) {
                        console.log(result);

                        if (result.status) {

                            //grafico(result);

                            //renderTable(result);

                            //renderCalendario(result);
                        } else {
                            dashboard.alertErro(result.mensagem);
                        }
                    },
                    complete: function () {
                        $(".loading").hide();
                    }
                });
            } else {
                dashboard.alertAtencao("Todos Campos são obrigatorios");
            }

        });
    });
</script>

@using DashBoardAgil.CrossCutting
@using DashBoardAgil.Services.Domain
@using DashBoardAgil.Services.Util

@{
    var ListAbas = new Dictionary<string, string>()
    {
        {"Info", "fas fa-info-circle"},
        {"Prioridade", "fas fa-chart-bar"},
        {"Tipo", "fas fa-chart-bar"},
       // {"Pizza", "fas fa-chart-pie"},
        {"Dados", "fas fa-list-alt"},

    };

    var listTable = new List<string> {"#", "Projeto", "Status", "Total(Horas)"};
}

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                Consulta @ViewBag.Title
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-lg-12">
                        <form role="form" action="JavaScript: return false;">
                            <div class="form-group col-lg-6">
                                <label>Time:</label>
                                @*<input class="form-control" >*@
                                @Html.DropDownList("time", (SelectList) ViewBag.SelectTime, "Selecione", htmlAttributes: new {@class = "form-control lockable", required = true})
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-6">
                                <label>Projeto:</label>
                                @*<input class="form-control" >*@
                                <select class="form-control lockable" id="projetos">
                                    <option value="">Selecione</option>
                                </select>
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-3">
                                <label>Sla: De</label>
                                @*<input class="form-control" >*@
                                @Html.DropDownList("redmineDe", (SelectList) ViewBag.SelectStatusRedmineDe, "Selecione", htmlAttributes: new {@class = "form-control", required = true})
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-3">
                                <label>Para</label>
                                @*<input class="form-control" >*@
                                @Html.DropDownList("redminePara", (SelectList) ViewBag.SelectStatusRedminePara, "Selecione", htmlAttributes: new {@class = "form-control", required = true})
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-3">
                                <label>Prioridade: </label>
                                @*<input class="form-control" >*@
                                @Html.DropDownList("prioidade", (SelectList) ViewBag.SelectPrioridadeRedmine, "Selecione", htmlAttributes: new {@class = "form-control", required = true})
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-3">
                                <label>Tipo: </label>
                                @*<input class="form-control" >*@
                                @Html.DropDownList("tipoChamado", (SelectList) ViewBag.SelectTipoChamado, "Selecione", htmlAttributes: new {@class = "form-control", required = true})
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-6">
                                <label>Periodo: Inicio</label>
                                @*<input class="form-control" >*@
                                <input type="date" id="dataIni" name="dataIni" class="form-control" value="@DateTime.Now.Date.AddDays(-30).ToString("yyyy-MM-dd")" required/>
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-6">
                                <label>Fim</label>
                                @*<input class="form-control" >*@
                                <input type="date" id="dataFim" name="dataFim" class="form-control" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" required="@ConstantesCC.CAMPO_OBRIGATORIO"/>
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-12">
                                <button type="button" id="pesquisar" class="btn btn-primary">Pesquisar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_resultDefault", new DashBoardAgil.DashBoardApi.Models.ResultDefaultModel(listTable, ListAbas, false, false, false))

<script>
    $(document).ready(function() {

        function valid(data) {
            if (time == "" || data.redminieDe == 0 || data.redminiePara == 0 || data.dataIni == "" || data.dataFim == "") {
                return false;
            }
            return true;
        }

        $("#time").on("change", function(e) {

            var data = new Object();

            data.id = $(this).val();

            if (data.id) {
                data.parent = true;
                data.customField = 0;
                $.ajax({
                    url: "@Url.Action("", "api/Project")",
                    data: data,
                    method: "GET",
                    beforeSend: function() {
                        $("#projetos").html("");
                        $("#projetos").append('<option value="">Selecione</option>');
                        blockCampos(true);

                    },
                    success: function(result) {

                        result.forEach(function(item, index) {
                            $("#projetos").append('<option value="' + item.Identifier + '">' + item.Name + '</option>');
                        });
                    },
                    complete: function() {
                        blockCampos(false);
                    }
                });
            }
        });

        function renderTable(result) {

            $('#dados').html('<table id="dado_table" class="display table table-striped table-bordered" width="100%"><thead></thead><tbody></tbody></table>');

            var dataset = new Array();

            result.LeadTimes.forEach(function(item, index) {
                dataset.push(['<a target="_blank" href="http://redmine.example.com/issues/' + item.IdChamado + '">' + item.IdChamado + '</a>', item.Projeto, item.Status.Name, item.TipoString, item.PrioridadeString, item.LeadBrutoDays]);
                //result.LeadTimes[index].link = '<a target="_blank" href="http://redmine.example.com/issues/' + item.IdChamado + '">' + item.IdChamado + '</a>';
            });

            console.log(result.LeadTimes);
          var  dataTable =   $('#dado_table').DataTable({
              data: dataset,
                columns: [
                    { title: "#", DataProp: "link" },
                    // { title: "Titulo" },
                    { title: "Projeto", DataProp: "Projeto" },
                    { title: "Status.", DataProp: "Status.Name" },
                    { title: "Tipo", DataProp: "TipoString" },
                    { title: "Prioridade", DataProp: "PrioridadeString" },
                    { title: "Tempo (Dias)", DataProp: "LeadBrutoDays" }
                ]
          });
            dataTable.destroy();
            renderDatatable("#dado_table");
        }

        function renderGraficos(result) {

            var CategoriaPrioridade = new Array();
            CategoriaPrioridade.push("Media Geral");
            var seriePrioridade = new Array();
            result.ByPriority.forEach(function(item) {
                var SerieObject = new Object();
                SerieObject.name = item.Prioridade;
                SerieObject.data = [item.LeadBruto / 24];
                seriePrioridade.push(SerieObject);
            });

            var serieTipo = new Array();
            result.ByType.forEach(function(item) {
                var SerieObject = new Object();
                SerieObject.name = item.Tipo;
                SerieObject.data = [item.LeadBruto / 24];
                serieTipo.push(SerieObject);
            });

            renderTable(result);
            renderCollumChart("prioridade", "Prioridade", "", CategoriaPrioridade, "Dias", "dias", seriePrioridade);
            renderCollumChart("tipo", "Tipo", "", CategoriaPrioridade, "Dias", "dias", serieTipo);
            //  renderPizzaChart("pizza", "", "", result.ByProcess.series, result.ByProcess.drilldown, "dias");
        }

        $("#pesquisar").on("click", function(e) {

            var data = new Object();
            data.time = $("#projetos").val()? $("#projetos").val():  $("#time").val();
            data.prioridade = $("#prioidade").val();
            data.tipoChamado = $("#tipoChamado").val();
            data.statusDe = $("#redmineDe").val();
            data.statusPara = $("#redminePara").val();
            data.dataIni = $("#dataIni").val();
            data.dataFim = $("#dataFim").val();

            if (valid(data)) {

                $.ajax({
                    url: "@Url.Action("", "api/CicleTime")",
                    data: data,
                    method: "GET",
                    beforeSend: function() {
                        $("#resultado").show();
                        $(".loading").show();
                        $(".dados").hide();
                        $("#i_tab-@ListAbas.FirstOrDefault().Key.ToLowerInvariant()").click();
                        limpar();
                        blockCampos(true);
                    },
                    success: function(result) {
                       // console.log(result);
                        renderGraficos(result);
                        // renderTable(result);
                    },
                    error: function(item) {
                        dashboard.alertErro("Ocorreu um erro na consulta ao servidor: " + item);
                    },
                    complete: function() {
                        $(".dados").show();
                        $(".loading").hide();
                        $("#resultado").show();
                        blockCampos(false);
                    }

                });
            } else {
                dashboard.alertAtencao("Todos Campos são obrigatorios");
            }

        });
    });
</script>
@Scripts.Render("~/bundles/jqueryval")
@using DashBoardAgil.CrossCutting
@using DashBoardAgil.Services.Domain
@using DashBoardAgil.Services.Util

@{

}

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                @String.Format(ViewBag.title)
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-lg-12">
                        <form role="form" action="JavaScript: return false;">
                            <div class="form-group col-lg-12">
                                <label>Time:</label>
                                @*<input class="form-control" >*@
                                @Html.DropDownList("time", (SelectList)ViewBag.SelectTime, "Selecione", htmlAttributes: new { @class = "form-control lockable", required = true })
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-12">
                                <label>Projeto:</label>
                                @*<input class="form-control" >*@
                                <select class="form-control lockable" id="projetos">
                                    <option value="0">Selecione</option>
                                </select>
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-6">
                                <label>Periodo: Inicio</label>
                                @*<input class="form-control" >*@
                                <input type="date" id="dataIni" name="dataIni" class="form-control" value="@((new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)).ToString("yyyy-MM-dd"))" required />
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="form-group col-lg-6">
                                <label>Fim</label>
                                @*<input class="form-control" >*@
                                <input type="date" id="dataFim" name="dataFim" class="form-control" value="@(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddDays(+30).ToString("yyyy-MM-dd"))" required="" />
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <button type="button" id="pesquisar" class="btn btn-primary lockable">Pesquisar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_resultDefault",  new DashBoardAgil.DashBoardApi.Models.ResultDefaultModel( new List<string> { "Dia", "Projeto", "Desenvolvedor", "Total(Horas)" },null, true, false, false))

<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script>
    google.charts.load('current', { 'packages': ['gauge'] });

    $(document).ready(function () {
        $("#resultado").hide();
        $(".loading").hide();


        function valid(data) {
            if (time === "" || data.IdSla === 0 || data.tempo === 0 || data.dataIni === "" || data.dataFim === "") {
                return false;
            }
            return true;
        }


        function grafico(result) {

            $(".dados").show();
            var elemnts = [];

            result.ConsumoHoras.ByProject.forEach(function(iten, index) {
                var element = 'Gauge-' + iten.GaugeGoogle.data.Label;

                var ret = new Object();

                ret.element = element;
                ret.GaugeGoogle = new Object();
                ret.GaugeGoogle = iten.GaugeGoogle;
                ret.legend = iten.GaugeGoogle.data.Label.replace(/\-/g, ' ');
                elemnts.push(ret);

            });
            renderCarousel(elemnts, "#render_Grafico");
            renderGaugeGoogleAll(elemnts);
            // renderGaugeGoogle("render_Grafico", result.ConsumoHoras.ByProject[0].GaugeGoogle.data, result.ConsumoHoras.ByProject[0].GaugeGoogle.options);
        }

        function renderTable(result) {
            //var table = $("#_tableAmostra tbody");
            var table = $("#_tableAmostra").DataTable();

            table.clear().draw();

            result.DiaDevControl.forEach(function (diaDev, index0) {
                diaDev.LancamentosDiaDesenvolvedor.forEach(function (chamado, index) {

                    var conteudo = new Array();

                    //conteudo.push("<a title='' target='_blank' href='http://redmine.example.com/projects/" + diaDev.Time.Identifier + "/time_entries?spent_on=><" + result.filtro.dataIni.substring(0, 10) + "|" + result.filtro.dataFim.substring(0, 10) + "&user_id=" + chamado.User.Id + "'>" + chamado.DiaString + "</a>");
                    conteudo.push("");
                    conteudo.push(diaDev.Time.Identifier);
                    conteudo.push(chamado.User.FirstName);
                    conteudo.push(chamado.TotalHoraDia);
                    table.row.add(conteudo);
                });
            });

            table.draw();

        }

        function renderCalendario(result) {

            var notes = new Array();
            result.DiaDevControl.forEach(function (diaDev, index0) {
                diaDev.LancamentosDia.forEach(function (item, index) {

                    var object = new Object();

                    object.date = item.Dia.substring(0, 10);
                    object.note = item.Devs;
                    notes.push(object);
                    //[
                    //    { "date": "2018-12-25", "note": ["Natal"] },
                    //    { "date": "2018-12-12", "note": ["Tahun Baru"] }
                    //]
                });
            });

            renderCalendar("#tab_cal_dados", notes, result.filtro.dataIni.substring(0, 10), result.filtro.dataFim.substring(0, 10));

        }

        $("#time").on("change", function (e) {

            var data = new Object();

            data.id = $(this).val();

            if (data.id) {
                data.parent = true;
                data.customField = 143;
                $.ajax({
                    url: "@Url.Action("", "api/Project")",
                    data: data,
                    method: "GET",
                    beforeSend: function () {
                        $("#projetos").html("");
                        $("#projetos").append('<option value="0">Selecione</option>');
                        blockCampos(true);
                    },
                    success: function (result) {
                        console.log(result);
                        result.forEach(function (item, index) {
                            $("#projetos").append('<option value="' + item.Identifier + '">' + item.Name + '</option>');
                        });
                    },
                    complete: function () {
                        blockCampos(false);
                    }
                });
            }
        });

        $("#pesquisar").on("click", function (e) {

            $("#resultado").hide();
            limpar();
            $('#i_tab-grafico').click();

            var data = new Object();

            data.project = $("#projetos").val();
            data.time = $("#time").val();
            data.dataIni = $("#dataIni").val();
            data.dataFim = $("#dataFim").val();

            if (valid(data)) {

                $.ajax({
                    url: "@Url.Action("", "api/TimesEntry")",
                    data: data,
                    method: "GET",
                    beforeSend: function () {
                        $("#resultado").show();
                        $(".loading").show();
                        $(".dados").hide();
                    },
                    success: function (result) {
                        console.log(result);

                        if (result.status) {

                            grafico(result);

                            //renderTable(result);

                            //renderCalendario(result);
                        } else {
                            dashboard.alertErro(result.mensagem);
                        }

                    },
                    complete: function () {
                        $(".loading").hide();
                    }

                });
            } else {
                dashboard.alertAtencao("Todos Campos são obrigatorios");
            }

        });
    });
</script>
@Scripts.Render("~/bundles/jqueryval")

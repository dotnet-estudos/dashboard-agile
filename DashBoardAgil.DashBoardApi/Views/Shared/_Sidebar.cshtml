@using DashBoardAgil.DashBoardApi.Models
@using DashBoardAgil.Services.Enums
@using DashBoardAgil.Services.Domain

@{
    //carregar o menu dinamicamente
    var ItensMenu = (List<DashBoardAgil.Services.Domain.Menu>)Session["ItensMenu"];
    //var ItensMenu = (String)Session["ItensMenu"];

}

<div class="navbar-default sidebar" role="navigation">
    <div class="sidebar-nav navbar-collapse">
        <ul class="nav" id="side-menu">
            <li class="sidebar-search">
                <div class="input-group custom-search-form">
                    <input type="text" class="form-control" placeholder="Search...">
                    <span class="input-group-btn">
                        <button class="btn btn-primary" type="button">
                            <i class="fa fa-search"></i>
                        </button>
                    </span>
                </div>
            </li>
            <!--Exibição menu dinâmico-->
            @foreach (var item in ItensMenu)
            {
                <li>
                    <a href="@String.Format(item.Url)"><i class="@String.Format(item.Icone)"></i> @String.Format(item.Titulo) <span class="@String.Format(item.SubMenus.Count > 0 ? "fa arrow" : "")"></span></a>
                    @if (item.SubMenus.Count > 0)
                    {
                        <ul class="nav nav-second-level">
                            @foreach (var sub in item.SubMenus)
                            {
                            <li>
                                <a href="@String.Format(sub.Url)" @Html.Raw(sub.IdUrl !="" ? "id='"+sub.IdUrl+"'" : "")><i class="@String.Format(sub.Icone)"></i> @Html.Raw(sub.Titulo)</a>
                            </li>
                            }
                        </ul>
                    }
                </li>
            }
            <!--Fim Exibição menu dinâmico-->
            <!--Exemplo
            <li> 
                <a href="Home" class="active"><i class="fas fa-tachometer-alt fa-fw"></i> Teste</a>
            </li>
            <li>
                <a href="#"><i class="fa fa-sitemap fa-fw"></i> Multi-Level Dropdown<span class="fa arrow"></span></a>
                <ul class="nav nav-second-level">
                    <li>
                        <a href="#">Second Level Item</a>
                    </li>
                    <li>
                        <a href="#">Third Level <span class="fa arrow"></span></a>
                        <ul class="nav nav-third-level">
                            <li>
                                <a href="#">Third Level Item</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </li>
            Fim Exemplo-->
        </ul>
    </div>
</div>
<script>
    $(document).ready(function () {
        $.ajax({
            url: "@Url.Action("","api/Agente")",
            beforeSend: function () {
                // $("#divCarregando").show();
            },
            success: function (result) {
                // $("#divCarregando").hide();
                $('#_togleAgent').prop('type', "checkbox");
                $('#_togleAgent').prop('checked', result.status);
                $.switcher('#_togleAgent');
                //var pro = $('#_togleAgent').prop('checked'); //, result.status);
                //console.log(pro);
            },
            complete: function () {
                // $("#divCarregando").hide();
            }
        });

        $("#_togleAgent").on("change", function () {

            $.ajax({
                url: "@Url.Action("99","api/Agente")",
                data: 1,
                method: "PUT",
                success: function (result) {
                    $('#_togleAgent').prop('checked', result.status);
                    var msg = result.status ? "A" : "Desa";
                    dashboard.alertSucesso("Serviço " + msg + "tivado Com Sucesso!");
                    var pro = $('#_togleAgent').prop('checked'); //, result.status);
                    console.log(pro);
                }
            });


        });

    });
</script>
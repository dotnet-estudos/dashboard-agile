@using DashBoardAgil.CrossCutting
@model DashBoardAgil.DashBoardApi.Models.Logger




<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                Log
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-lg-12">
                        <form role="form" action="JavaScript: return false;">
                            <div class="form-group col-lg-2">
                                <label>Periodo: Inicio</label>
                                @*<input class="form-control" >*@
                                <input type="date" id="logData" name="logData" class="form-control" max="@ViewBag.logData" value="@ViewBag.logData" required />
                                @*<p class="help-block">Exemplo: -level help text here.</p>*@
                            </div>
                            <div class="row">
                                <div class="form-group col-lg-12">
                                    <button type="button" id="pesquisar" class="btn btn-primary">Pesquisar</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row" id="resultado">
    <div class="col-lg-12">
        <div class="panel tabbed-panel panel-primary">
            <div class="panel-heading clearfix">
                <div class="panel-title pull-left">Resultado</div>
                <div class="pull-right active">
                    <ul class="nav nav-tabs in">
                        <li class="active"><a href="#tab-dados" id="i_tab-dados" data-toggle="tab" aria-expanded="true"><i class="far fa-list-alt"></i> Dados</a></li>
                    </ul>
                </div>
            </div>
            <div class="panel-body">
                <div class="tab-content">
                    <div class="tab-pane fade active in" id="tab-dados">

                        <div id="carregando" class="loading">
                            <div id="overlay"></div>
                            <i class="fas fa-cog fa-spin"></i>
                        </div>
                        <div class="dados">
                            <label>Amostra:</label>
                            <div id="tableConteudo">
                                @Html.TextAreaFor(model => model.Log, htmlAttributes: new { @class = "form-control", @style = "width: 100%; height: 500px;" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /.panel -->
    </div>

</div>

<script>

</script>


<script>
    $(document).ready(function () {
        //$("#resultado").hide();
        $(".loading").hide();


        function valid(data) {
            if (data.logData == "") {
                return false;
            }
            return true;
        }

        function limpar() {
            $("#Log").val("");
        }



        function renderTable(result) {
            $("#Log").val(result.Mensagem);

        }

        $("#pesquisar").on("click", function (e) {

            $("#resultado").hide();
            limpar();

            var data = new Object();

            data.logData = $("#logData").val();


            if (valid(data)) {

                $.ajax({
                    url: "@Url.Action("", "api/Log")",
                    data: data,
                    method: "GET",
                    beforeSend: function () {
                        $("#resultado").show();
                        $(".loading").show();
                        $(".dados").hide();
                    },
                    success: function (result) {
                        $(".dados").show();
                        renderTable(result);
                    },
                    error: function (result) {
                        dashboard.alertErro("Arquivo Não Encontrado");
                    },
                    complete: function () {
                        $(".loading").hide();
                    }

                });
            } else {
                dashboard.alertAtencao("Todos Campos são obrigatorios");
            }

        });
    });
</script>
@Scripts.Render("~/bundles/jqueryval")
@model IEnumerable<DashBoardAgil.Domain.Models.Menu>
@using DashBoardAgil.CrossCutting;
@{

}
@*
    <p>
        @Html.ActionLink("Adicionar", "Create", "Projeto", new { tipo = ViewBag.Tipo }, htmlAttributes: new { @class = "btn btn-primary" })
    </p>
*@
<table class="table table-striped table-bordered" data-datatable="true">
    <thead>
        <tr>
            <th width="30%">
                @Html.DisplayNameFor(model => model.Titulo)
            </th>
            <th width="39%">
                @Html.DisplayNameFor(model => model.Url)
            </th>
            <th width="10%">
                @Html.DisplayNameFor(model => model.Permissoes)
            </th>
            <th width="10%">
                Id
            </th>
            <th width="10%">
                @Html.DisplayNameFor(model => model.Visivel)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @String.Format(item.Titulo)
                </td>
                <td>
                    @String.Format(item.Url)
                </td>
                <td>
                    @for (int x = 0; x < item.Permissoes.Count; x++)
                    {
                        @String.Format(item.Permissoes[x].GetDisplayName())
                        if (!x.Equals(item.Permissoes.Count - 1))
                        {
                            @String.Format(", ")
                        }
                    }
                </td>
                <td>
                    @String.Format(item.Id.ToString())
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Visivel)
                </td>
            </tr>
            if (item.SubMenus.Count > 0)
            {
                <tr>
                    <td colspan="6">
                        <table class="table table-striped table-bordered" data-datatable="true">
                            @foreach (var sub in item.SubMenus)
                            {
                            <tr>
                                
                                <td>
                                    @String.Format(sub.Titulo)
                                </td>
                                <td>
                                    @String.Format(sub.Url)
                                </td>
                                <td>
                                    @for (int x = 0; x < sub.Permissoes.Count; x++)
                                    {
                                        @String.Format(sub.Permissoes[x].GetDisplayName())
                                        if (!x.Equals(sub.Permissoes.Count - 1))
                                        {
                                            @String.Format(", ")
                                        }
                                    }
                                </td>
                                <td>
                                    @String.Format(sub.IdPai.HasValue ? sub.IdPai.ToString() : "")
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => sub.Visivel)
                                </td>
                            </tr>
                            }
                        </table>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        $('table[data-datatable=true]').DataTable();
    });
</script>
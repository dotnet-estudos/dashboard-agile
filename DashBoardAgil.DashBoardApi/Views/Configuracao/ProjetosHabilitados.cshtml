@model IEnumerable<DashBoardAgil.Domain.Models.Projeto>
@{
    
}
<p>
    @Html.ActionLink("Adicionar", "Create", "Projeto", new {tipo = ViewBag.Tipo}, htmlAttributes: new {@class = "btn btn-primary"})
</p>


<table class="table table-striped table-bordered" data-datatable="true">
    <thead>
    <tr>
        @*<th>
            Projeto Pai
        </th>*@
        <th>
            @Html.DisplayNameFor(model => model.Identifier)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.QuantidadeDesenvolvedores)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ProcessoId)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Ativo)
        </th>
        <th></th>
    </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                @*<td>
                    @String.Format(item.Parent.ToString())
                </td>*@
                <td>
                    @String.Format(item.ToString())
                </td>
                <td>
                    @String.Format(item.QuantidadeDesenvolvedores.ToString())
                </td>
                <td>
                    @String.Format(item.ProcessoId.ToString())
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Ativo)
                </td>
                <td>
                    @Html.ActionLink(" ", "Edit", "Projeto", new { id = item.Id, tipo = ViewBag.Tipo }, htmlAttributes: new { @class = "fas fa-edit" }) |
                    @Html.ActionLink(" ", "Details", "Projeto", new { id = item.Id, topo = ViewBag.Tipo }, htmlAttributes: new { @class = "fas fa-info" }) |
                    @Html.ActionLink(" ", "Delete", "Projeto", new { id = item.Id, tipo = ViewBag.Tipo }, htmlAttributes: new { @class = "fas fa-trash-alt" })
                </td>
            </tr>
        }
    </tbody>

</table>

<script>
    $(document).ready(function () {
        $('table[data-datatable=true]').DataTable();
    });
</script>